CI=

# Nuxt Auth Utils
NUXT_SESSION_PASSWORD=replace-with-at-least-32-characters

# Keycloak OAuth client (configure the client as confidential)
NUXT_OAUTH_KEYCLOAK_CLIENT_ID=tourmaline-web
NUXT_OAUTH_KEYCLOAK_CLIENT_SECRET=replace-with-keycloak-client-secret
NUXT_OAUTH_KEYCLOAK_SERVER_URL=http://localhost:8081
# Set this to http://keycloak:8080 when Nuxt runs inside docker-compose.
NUXT_OAUTH_KEYCLOAK_SERVER_URL_INTERNAL=
NUXT_OAUTH_KEYCLOAK_REALM=tourmaline
NUXT_OAUTH_KEYCLOAK_REDIRECT_URL=http://localhost:3000/auth/keycloak
